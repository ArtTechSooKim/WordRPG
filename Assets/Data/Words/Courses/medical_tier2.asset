    partOfSpeech: 
    example: 
    exampleMeaning: 
    story: 0
    storyHeading: 
    note: "\uCF69\uD325\uC740 \uBCF5\uAC15\uC758 \uB4A4\uC5D0 \uC704\uCE58\uD574
      \uC788\uACE0 \uC704, \uC18C\uC7A5 \uBC0F \uB300\uC7A5, \uCDCC\uC7A5, \uAC04,
      \uC4F8\uAC1C\uAC00 \uC874\uC7AC\uD558\uBA70 \uD749\uAC15\uACFC \uBCF5\uAC15\uC744
      \uAD6C\uBD84\uD558\uB294 \uD6A1\uACBD\uB9C9(diaphragm)\uC774 \uC874\uC7AC\uD55C\uB2E4."
