    english: dorsal cavity
    meaning: "\uB4F1\uCABD\uCCB4\uAC15"
    partOfSpeech: 
    example: 
    exampleMeaning: 
    story: 0
    storyHeading: 
    note: "\uC778\uCCB4\uC758 \uB4A4\uC5D0 \uC704\uCE58\uD558\uB294 \uCCB4\uAC15\uC774\uB2E4(\uBA38\uB9AC\uBF08\uC548\uACFC
