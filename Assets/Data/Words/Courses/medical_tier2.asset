  - id: med_cranial_cavity
    english: cranial cavity
    meaning: "\uBA38\uB9AC\uC548, \uB450\uAC1C\uAC15"
    partOfSpeech: 
    example: 
    exampleMeaning: 
    story: 0
    storyHeading: 
    note: "\uB1CC\uC640 \uB1CC\uD558\uC218\uCCB4\uAC00 \uC874\uC7AC\uD558\uB294 \uACF5\uAC04,
      \uB1CC\uB97C \uAC10\uC2F8\uACE0 \uC788\uB2E4."
  - id: med_thoracic_cavity
    english: thoracic cavity
    meaning: "\uAC00\uC2B4\uC548, \uD749\uAC15"
    partOfSpeech: 
    example: 
    exampleMeaning: 
    story: 0
    storyHeading: 
    note: "\uD3D0, \uC2EC\uC7A5, \uC2DD\uB3C4, \uAE30\uAD00, \uAE30\uAD00\uC9C0 \uB4F1\uC774
      \uC788\uB2E4. \uAC08\uBE44\uBF08\uC640 \uAC00\uC2B4\uADFC\uC721\uC73C\uB85C
      \uB458\uB7EC\uC2F8\uC5EC \uC788\uB2E4."
  - id: med_abdominopelvic_cavity
    english: abdominopelvic cavity
    meaning: "\uBCF5\uBD80\uACE8\uBC18\uAC15"
