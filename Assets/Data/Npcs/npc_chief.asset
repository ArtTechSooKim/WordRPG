  npcId: npc_chief
  displayName: "\uCD0C\uC7A5"
  frameWidth: 0
  stages:
  - bossOf: {fileID: 0}
    wordsNeeded: 0
    line: "\uC790\uB124 \uC774\uB984\uC774\u2026 \uD39C\u2026 \uC544\uB2C8, \uBB50\uC600\uB354\uB77C?"
    motion: 1
    pace: 0.7
  - bossOf: {fileID: 11400000, guid: 2f0f21b4f39acf14fab8b7273b5e1a17, type: 2}
    wordsNeeded: 0
    line: "{\uC774\uB984}! \uADF8\uB798, \uADF8 \uC774\uB984\uC774\uC57C!"
    motion: 0
    pace: 1
  springLeapAfter: {fileID: 0}
  springLeapLines: []
  entryLines: []
  bossThanksLines: []
  exitCallLines: []
  exitStoryLines: []
  giftItem: {fileID: 0}
  giftCount: 1
  giftBeforeBossOf: {fileID: 0}
  giftLines: []
  firstWinLines:
  - step: 0
    text: "\uD5C8\uC5B5\u2026 \uD5C8\uC5B5\u2026 \uC790\uB124! \uC7A0\uAE50\uB9CC
      \uAE30\uB2E4\uB824 \uBCF4\uAC8C!"
  - step: 0
    text: "\uC774\uC0C1\uD558\uAD6C\uBA3C\u2026\n\uBC8C\uC368 \uAE4C\uBA39\uC744
      \uB098\uC774\uB294 \uC544\uB2CC\uB370 \uB9D0\uC774\uC57C."
  - step: 0
    text: "\uBD84\uBA85 \uBB54\uAC00 \uC911\uC694\uD55C \uC77C\uC774 \uC788\uC5C8\uB358
      \uAC83 \uAC19\uC740\uB370\u2026\n\uB3C4\uBB34\uC9C0 \uAE30\uC5B5\uC774 \uB098\uC9C8
      \uC54A\uC544."
  - step: 1
    text: "\uBB34\uC2A8 \uC77C\uC774\uC2E0\uAC00\uC694?"
  - step: 0
    text: "\uC544\uBB34\uB798\uB3C4 \uAE4C\uBA39\uB300\uC655\uC774 \uB2E4\uC2DC \uB098\uD0C0\uB09C
      \uAC83 \uAC19\uB124!"
  - step: 0
    text: "\uADF8 \uB140\uC11D\uC774 \uB098\uD0C0\uB098\uBA74 \uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uC758\n\uAE30\uC5B5\uAE4C\uC9C0
      \uC0AC\uB77C\uC9C4\uB2E4\uACE0 \uB4E4\uC5C8\uC9C0."
  - step: 0
    text: "\uBD80\uD0C1\uC774\uB124.\n\uC11C\uACE0\uB85C \uAC00\uC11C \uAE4C\uBA39\uB300\uC655\uC744
      \uBB3C\uB9AC\uCCD0 \uC8FC\uAC8C\uB098!"
  - step: 0
    text: "\uC790\uB124\uAC00 \uC544\uB2C8\uBA74\n\uC774 \uC77C\uC744 \uD574\uACB0\uD560
      \uC0AC\uB78C\uC774 \uC5C6\uC744 \uAC83 \uAC19\uB124."
  - step: 2
    text: 
  - step: 0
    text: "\uC774\uAC74 \uB0B4 \uC791\uC740 \uC131\uC758\uC77C\uC138.\n\uC55E\uC73C\uB85C\uC758
      \uC5EC\uC815\uC5D0 \uB3C4\uC6C0\uC774 \uB420 \uAC78\uC138."
  - step: 0
    text: "\uBD80\uB514 \uC870\uC2EC\uD558\uAC8C\uB098!"
  firstWinGift: {fileID: 11400000, guid: 56596be176cf57541a9ab3caafeb386a, type: 2}
  firstWinGiftCount: 1
