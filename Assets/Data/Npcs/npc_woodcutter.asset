    pace: 1
  springLeapAfter: {fileID: 0}
  springLeapLines: []
  entryLines:
  - "\uC774\uBCF4\uAC8C, \uAC70\uAE30! \uC7A0\uAE50 \uBA48\uCD94\uAC8C!"
  - "\uC774 \uC232\uC5D0\uC120 \uAE38\uC744 \uC783\uAE30 \uC26C\uC6CC. \uD5F7\uAC08\uB108\uAD6C\uB9AC
    \uB140\uC11D\uC774 \uC774\uC815\uD45C\uB97C \uBABD\uB545 \uB4A4\uC11E\uC5B4 \uB1A8\uAC70\uB4E0."
  - "\uB098\uB3C4 \uBC8C\uC368 \uC0AC\uD758\uC9F8 \uAC19\uC740 \uC790\uB9AC\uB97C
    \uB9F4\uB3CC\uACE0 \uC788\uB2E4\uB124\u2026"
  - "\uB140\uC11D\uC740 \uBD81\uCABD \uACF5\uD130\uC5D0 \uC228\uC5B4 \uC788\uC5B4.
    \uACF5\uD130 \uBB38\uC740 \uC7A0\uACBC\uB294\uB370, \uC5F4\uC1E0\uAC00 \uC232
    \uC5B4\uB518\uAC00\uC5D0 \uB5A8\uC5B4\uC838 \uC788\uB2E4\uB354\uAD70."
  - "\uC232\uC758 \uB2E8\uC5B4\uB97C \uB9CE\uC774 \uCC3E\uC744\uC218\uB85D \uD798\uC774
    \uBD99\uC744 \uAC78\uC138. \uBD80\uB514 \uC774\uC815\uD45C\uB97C \uB418\uCC3E\uC544
    \uC8FC\uAC8C!"
  bossThanksLines:
  - "\uC774\uC815\uD45C\uAC00 \uB3CC\uC544\uC654\uAD70!"
  - "\uACE0\uB9D9\uB124. \uB355\uBD84\uC5D0 \uC774\uC81C \uAE38\uC744 \uD5F7\uAC08\uB9B4
    \uC77C\uC774 \uC5C6\uACA0\uC5B4."
  exitCallLines:
  - "\uC774 \uB108\uBA38\uB85C \uAC08 \uC0DD\uAC01\uC778\uAC00?"
  - "\uC640\uC11C \uB4E4\uC5B4 \uBCF4\uAC8C\uB098. \uC774\uC0C1\uD55C \uBA54\uC544\uB9AC
    \uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uC9C0 \uC54A\uB098?"
  exitStoryLines:
  - "\uB0B4 \uD560\uBA38\uB2C8\uAC00 \uBA54\uC544\uB9AC\uB97C \uB530\uB77C\uAC00\uB2E4\uAC00
    \uC774 \uB108\uBA38\uC5D0\uC11C \uC2E4\uC885\uB418\uC5C8\uB2E4\uC9C0\u2026"
  - "\uC704\uD5D8\uC774 \uB3C4\uC0AC\uB9AC\uACE0 \uC788\uC73C\uB2C8 \uC870\uC2EC\uD558\uB294
    \uAC8C \uC88B\uC744 \uAC70\uC57C."
  - "\uD589\uC6B4\uC744 \uBE4C\uACA0\uB124!"
