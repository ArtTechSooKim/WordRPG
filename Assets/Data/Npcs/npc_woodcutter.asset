    pace: 1.25
  - bossOf: {fileID: 11400000, guid: a3e19a296f3df11468a130c5e27e87f5, type: 2}
    wordsNeeded: 0
    line: "\uC774\uC815\uD45C\uAC00 \uB3CC\uC544\uC654\uAD70. \uB2AA \uB108\uBA38
      \uACF5\uD130\uB97C \uAC00 \uBD10."
