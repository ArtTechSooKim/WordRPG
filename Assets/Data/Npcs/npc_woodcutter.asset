  stages:
  - bossOf: {fileID: 0}
    wordsNeeded: 0
    line: "\uAE38\uC744 \uB0B4\uAC00 \uC783\uC5C8\uB2E4, \uC544\uB2C8 \uB098\uB97C
      \uAE38\uC774\u2026"
