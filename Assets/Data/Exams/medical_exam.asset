--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fef6b5bc73dcf6541a62d7f84b6a3ecd, type: 3}
  m_Name: medical_exam
  m_EditorClassIdentifier: WordRPG::WordRPG.Words.ExamBook
  questions:
  - id: medexam_02_01
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 1
    question: "\uC815\uC0C1\uC2EC\uC7A5\uC5D0\uC11C \uD2B9\uC218\uC804\uB3C4\uACC4\uC758
      \uC790\uADF9\uC804\uB3C4 \uC2DC\uC791\uBD80\uC704\uB294?"
    answer: sinoatrial node
  - id: medexam_02_02
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 2
    question: "\uC2EC\uC7A5\uBC15\uB3D9\uC774 \uC815\uC9C0\uD574\uC11C \uD608\uC561\uC744
      \uBC29\uCD9C\uD560 \uC218 \uC5C6\uAC8C \uB41C \uC0C1\uD0DC?"
    answer: cardiac arrest
  - id: medexam_02_03
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 3
    question: "\uC88C\uC2EC\uBC29\uACFC \uC6B0\uC2EC\uBC29 \uC0AC\uC774 \uC911\uACA9\uC758
      \uACB0\uC190\uC740?"
    answer: atrial septal defect
  - id: medexam_02_04
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 4
    question: "\uAD00\uC0C1\uB3D9\uB9E5\uC758 \uBD80\uBD84\uC801 \uD3D0\uC1C4, \uC2EC\uC7A5\uC774
      \uB9CE\uC774 \uD65C\uB3D9\uC2DC \uC99D\uC138\uAC00 \uC218\uBC18\uB418\uB294
      \uBCD1\uC740?"
    answer: angina pectoris
  - id: medexam_02_05
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 5
    question: "\uC2EC\uB0AD\uB0B4 \uCD9C\uD608\uC5D0 \uC758\uD558\uC5EC \uD608\uC561\uC774
      \uC800\uB958\uB418\uB294 \uAC83?"
    answer: hemopericardium
  - id: medexam_02_06
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 6
    question: "\uC2EC\uC7A5\uC758 \uB0B4\uBA74\uC744 \uC2F8\uACE0 \uC788\uB294 \uC2EC\uB0B4\uB9C9\uC758
      \uC5FC\uC99D?"
    answer: endocarditis
  - id: medexam_02_07
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 7
    question: "\uD0DC\uC0DD\uAE30\uC5D0 \uC0DD\uAE34 \uB3D9\uB9E5\uAD00\uC774 \uC0DD\uD6C4\uC5D0\uB3C4
      \uB2EB\uD788\uC9C0 \uC54A\uB294 \uAE30\uD615\uC740?"
    answer: patent ductus arteriosus
  - id: medexam_02_08
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 8
    question: "\uC2EC\uADFC\uC5D0 \uD5C8\uD608\uC131 \uBCC0\uD654\uB97C \uAC00\uC838\uC624\uB294
      \uBCD1\uC740?"
    answer: ischemic heart disease
  - id: medexam_02_09
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 9
    question: "\uC2EC\uC7A5\uC5D0 \uD53C\uB97C \uACF5\uAE09\uD558\uB294 \uD608\uAD00\uC774
      \uB9C9\uD600 \uADF8 \uB3D9\uB9E5\uC5D0 \uC758\uD574 \uC601\uC591\uBD84\uC744
      \uACF5\uAE09\uBC1B\uB294 \uBD80\uC704\uAC00 \uAD34\uC0AC\uC5D0 \uBE60\uC9C0\uB294
      \uC9C8\uD658\uC740?"
    answer: myocardial infarction
  - id: medexam_02_10
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 10
    question: "\uC2EC\uC7A5\uC774 \uD608\uC561\uC744 \uB9D0\uCD08\uB85C \uBCF4\uB0B4\uB294
      \uD38C\uD504\uC640 \uAC19\uC740 \uAE30\uB2A5\uC774 \uC0C1\uC2E4\uB41C \uC0C1\uD0DC\uB294?"
    answer: congestive heart disease (= congestive heart failure)
  - id: medexam_02_11
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 11
    question: "\uBCC0\uD615\uB41C \uC2EC\uC7A5 \uD310\uB9C9\uC758 \uC678\uACFC\uC801
      \uC7AC\uAC74\uC744 \uD1B5\uD574 \uD611\uCC29\uC774\uB098 \uBD80\uC871\uC744
      \uAC1C\uC120\uC2DC\uD0A4\uB294 \uC218\uC220\uC740?"
    answer: valvuloplasty
  - id: medexam_02_12
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 12
    question: "\uBD80\uC815\uB9E5 \uC9C4\uB2E8\uC744 \uC704\uD574 \uC2EC\uC804\uB3C4\uAE30\uB97C
      \uBAB8\uC5D0 \uC77C\uC815\uC2DC\uAC04 \uBD80\uCC29\uD558\uB294 \uAC80\uC0AC\uB294?"
    answer: holter monitoring
  - id: medexam_02_13
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 13
    question: "\uCD08\uC74C\uD30C\uB97C \uC774\uC6A9\uD574\uC11C \uC2EC\uC7A5, \uB300\uD608\uAD00\uC758
      \uD615\uD0DC, \uB3D9\uD0DC\uB97C \uAE30\uB85D\uD558\uB294 \uC9C4\uB2E8\uBC95?"
    answer: echocardiography
  - id: medexam_02_14
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 14
    question: "\uB2E4\uB978 \uC0AC\uB78C\uC758 \uC2EC\uC7A5\uC744 \uD658\uC790\uC5D0\uAC8C
      \uC774\uC2DD\uD558\uB294 \uC678\uACFC\uC218\uC220\uC740?"
    answer: heart transplantation
  - id: medexam_02_15
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 15
    question: "\uC2EC\uC2E4\uC0AC\uC774\uC758 \uC0AC\uC774\uB9C9(\uC911\uACA9)\uC5D0
      \uC791\uC740 \uAD6C\uBA4D\uC774 \uC788\uB294 \uC120\uCC9C\uC131 \uC2EC\uC7A5\uC9C8\uD658\uC740?
      (\u2460 TOF \u2461 VSD \u2462 ASD \u2463 PDA \u2464 PFO)"
    answer: "\u2461 VSD"
  - id: medexam_02_16
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 16
    question: "\uC2EC\uC7A5\uC9C8\uD658\uC758 \uC9C4\uB2E8\uC744 \uC704\uD55C \uAC80\uC0AC\uB85C
      \uBB36\uC778 \uAC83\uC740? (\uAC00. heart scan \uB098. echocardiography \uB2E4.
      cardiocentesis \uB77C. encephalography) (\u2460 \uAC00,\uB098,\uB2E4 \u2461
      \uAC00,\uB2E4 \u2462 \uB098,\uB77C \u2463 \uB77C \u2464 \uAC00,\uB098,\uB2E4,\uB77C)"
    answer: "\u2460 \uAC00,\uB098,\uB2E4"
  - id: medexam_02_17
    chapter: 2
    chapterTitle: "\uC81C2\uC7A5 \uC2EC\uD608\uAD00 \uBC0F \uC870\uD608\uACC4"
    number: 17
    question: "arrythmia\uB85C \uBAA8\uB450 \uBB36\uC778 \uAC83\uC740? (\uAC00. flutter
      \uB098. fibrillation \uB2E4. palpitation \uB77C. heart block) (\u2460 \uAC00,\uB098
      \u2461 \uAC00,\uB098,\uB2E4 \u2462 \uAC00,\uB098,\uB77C \u2463 \uB098,\uB2E4,\uB77C
      \u2464 \uB2E4,\uB77C)"
    answer: "\u2462 \uAC00,\uB098,\uB77C"
  - id: medexam_03_01
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 1
    question: "\uC228\uC274 \uB54C \uACF5\uAE30\uAC00 \uB4DC\uB098\uB4E4\uBA70 \uD6C4\uB450\uC5D0\uC11C
      \uD3D0\uB85C \uC774\uC5B4\uC9C4 \uC228\uAE38\uC740?"
    answer: trachea
  - id: medexam_03_02
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 2
    question: "\uD3D0 \uB0B4\uC758 \uC774\uCC28\uAE30\uAD00\uC9C0\uAC00 \uB2E4\uC2DC
      \uAC00\uC9C0\uB97C \uCCD0\uC11C \uC9C1\uACBD\uC774 1mm \uC774\uD558\uC758 \uC791\uC740
      \uAC00\uC9C0\uB294?"
    answer: bronchiole
  - id: medexam_03_03
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 3
    question: "\uAE30\uAD00\uC9C0 \uB05D\uC5D0 \uB2EC\uB824\uC788\uC73C\uBA70, \uAC00\uC2A4\uAD50\uD658\uC774
      \uC77C\uC5B4\uB098\uB294 \uACF3\uC740?"
    answer: alveolus
  - id: medexam_03_04
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 4
    question: "\uC0AC\uB78C\uC758 \uC785\uC18D \uC591\uCABD \uAD6C\uC11D\uC5D0 \uD37C\uC838
      \uC788\uB294 \uB9BC\uD504 \uC18C\uC808\uC758 \uC9D1\uD569\uCCB4\uB85C \uBA74\uC5ED\uAE30\uB2A5\uC5D0
      \uAD00\uC5EC\uD558\uB294 \uAC83\uC740?"
    answer: tonsil
  - id: medexam_03_05
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 5
    question: "\uC74C\uC2DD\uBB3C\uC774 \uC2DD\uB3C4\uB85C \uB118\uC5B4\uAC08 \uB54C
      \uAE30\uAD00\uACFC \uD6C4\uB450\uB85C \uB4E4\uC5B4\uC624\uC9C0 \uBABB\uD558\uB3C4\uB85D
      \uD6C4\uB450\uB97C \uB36E\uB294 \uAE30\uAD00\uC740?"
    answer: epiglottis
  - id: medexam_03_06
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 6
    question: "\uD3D0\uC758 \uD45C\uBA74 \uBC0F \uD749\uACFD\uBCBD\uC758 \uB0B4\uBA74\uC744
      \uB36E\uACE0 \uC788\uB294 \uC774\uC911 \uB9C9\uC740?"
    answer: pleura
  - id: medexam_03_07
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 7
    question: "\uC88C\uC6B0\uC758 \uD749\uAC15 \uC0AC\uC774\uC5D0\uC11C \uC591\uCABD\uD3D0\uB97C
      \uBD84\uB9AC\uD558\uACE0 \uC788\uB294 \uC870\uC9C1\uACFC \uAE30\uAD00\uC740?"
    answer: mediastinum
  - id: medexam_03_08
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 8
    question: "\uBC14\uC774\uB7EC\uC2A4, \uC138\uADE0, \uC9C4\uADE0 \uAC10\uC5FC\uACFC
      \uC54C\uB808\uB974\uAE30\uBE44\uC5FC\uC5D0 \uC758\uD574 \uC0DD\uAE34 \uBD80\uBE44\uB3D9
      \uC5FC\uC99D\uC740?"
    answer: sinusitis
  - id: medexam_03_09
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 9
    question: "\uAE30\uAD00\uC9C0\uC758 \uADFC\uC721\uACFC \uD0C4\uB825\uC9C0\uC9C0\uC870\uC9C1\uC774
      \uD30C\uAD34\uB418\uC5B4 \uC601\uAD6C\uD788 \uD655\uC7A5\uB418\uB294 \uC9C8\uD658\uC740?"
    answer: bronchiectasis
  - id: medexam_03_10
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 10
    question: "\uC5EC\uB7EC \uC790\uADF9\uC5D0 \uB300\uD574\uC11C \uAE30\uAD00\uC9C0\uAC00
      \uACFC\uBBFC\uD55C \uBC18\uC751\uC744 \uC77C\uC73C\uCF1C \uC0DD\uAE30\uB294
      \uAE30\uAD00\uC9C0\uC758 \uAC00\uC5ED\uC801\uC778 \uACBD\uB828\uC131 \uB9C9\uD798\uC740?"
    answer: asthma
  - id: medexam_03_11
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 11
    question: "\uC870\uC9C1\uC774\uB098 \uAE30\uAD00\uC5D0 \uACF5\uAE30\uAC00 \uBCD1\uC801\uC73C\uB85C
      \uCD95\uC801\uB418\uB294 \uC9C8\uD658\uC740?"
    answer: emphysema
  - id: medexam_03_12
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 12
    question: "\uD3D0\uC5D0 \uBA3C\uC9C0\uAC00 \uC313\uC5EC \uC0DD\uAE30\uB294 \uC9C1\uC5C5\uBCD1\uC73C\uB85C
      \uAD11\uBD80\uC5D0\uC11C \uBC1C\uC0DD\uBE48\uB3C4\uAC00 \uB192\uC740 \uC9C8\uD658\uC740?"
    answer: pneumoconiosis
  - id: medexam_03_13
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 13
    question: "\uACB0\uD575\uADE0\uC774 \uD3D0\uC5D0 \uB4E4\uC5B4\uAC00 \uC5FC\uC99D\uC744
      \uC77C\uC73C\uD0A4\uB294 \uC9C8\uD658\uC740?"
    answer: pulmonary tuberculosis
  - id: medexam_03_14
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 14
    question: "\uC0C1\uC545\uB3D9\uC5FC \uCE58\uB8CC\uB97C \uC704\uD574 \uC0C1\uC545\uB3D9\uC5D0
      \uAD6C\uBA4D\uC744 \uB9CC\uB4DC\uB294 \uC218\uC220\uC740?"
    answer: caldwell-luc operation
  - id: medexam_03_15
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 15
    question: "\uD749\uBCBD\uC758 \uC678\uACFC\uC801 \uC808\uAC1C\uC220\uC740?"
    answer: thoracotomy
  - id: medexam_03_16
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 16
    question: "\uC758\uC2DD\uC18C\uC2E4\uB85C \uAE30\uB3C4\uC720\uC9C0\uAC00 \uC5B4\uB824\uC6CC
      \uAE30\uB3C4\uD655\uBCF4\uC640 \uD638\uD761\uC870\uC808\uC744 \uBAA9\uC801\uC73C\uB85C
      \uD558\uB294 \uCC98\uCE58\uB294?"
    answer: endotracheal intubation
  - id: medexam_03_17
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 17
    question: "\uC88C\uC6B0\uCE21 \uCF67\uAD6C\uBA4D \uC0AC\uC774\uC5D0 \uC788\uB294
      \uC911\uAC04 \uCE78\uB9C9\uC774\uAC00 \uD55C\uCABD\uC73C\uB85C \uD718\uB294
      \uC9C8\uD658\uC740?"
    answer: deviated nasal septum (deviation of nasal septum)
  - id: medexam_03_18
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 18
    question: "\uD638\uD761\uC758 \uAE4A\uC774\uAC00 \uADDC\uCE59\uC801\uC73C\uB85C
      \uC99D\uAC10\uD558\uBA70 \uBB34\uD638\uD761\uAE30\uAC00 \uAD50\uB300\uD558\uB294
      \uD638\uD761\uC740? (\u2460 orthopnea \u2461 dyspnea \u2462 tachypnea \u2463
      hyperventilation \u2464 Cheyne-Stokes respiration)"
    answer: "\u2464 Cheyne-Stokes respiration"
  - id: medexam_03_19
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 19
    question: "\uD638\uD761\uAE30\uACC4 \uC9C8\uD658\uC758 \uC9C4\uB2E8\uC5D0\uC11C
      \uB4E4\uC744 \uC218 \uC788\uB294 \uBE44\uC815\uC0C1\uC801\uC778 \uC18C\uB9AC\uAC00
      \uC544\uB2CC \uAC83\uC740? (\u2460 pleural rub \u2461 rales \u2462 murmur \u2463
      wheeze \u2464 stridor)"
    answer: "\u2462 murmur"
  - id: medexam_03_20
    chapter: 3
    chapterTitle: "\uC81C3\uC7A5 \uD638\uD761\uAE30\uACC4"
    number: 20
    question: "DPT\uC5D0 \uC18D\uD558\uB294 \uC9C8\uD658\uC774 \uC544\uB2CC \uAC83\uC740?
      (\u2460 \uD30C\uC0C1\uD48D \u2461 pertussis \u2462 \uB514\uD504\uD14C\uB9AC\uC544
      \u2463 \uD48D\uC9C4 \u2464 tetanus)"
    answer: "\u2463 \uD48D\uC9C4"
  - id: medexam_04_01
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 1
    question: "\uB300\uC7A5\uC758 \uB05D\uC5D0\uC11C \uD56D\uBB38\uC5D0 \uC774\uB974\uB294
      \uACE7\uC740 \uBD80\uBD84\uC740?"
    answer: rectum
  - id: medexam_04_02
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 2
    question: "\uC18C\uC7A5\uC758 \uB9D0\uB2E8\uBD80\uC5D0\uC11C \uB300\uC7A5\uC73C\uB85C
      \uC774\uD589\uD558\uB294 \uBD80\uC704\uC5D0 \uC788\uB294 \uC18C\uD654\uAD00\uC740?"
    answer: cecum
  - id: medexam_04_03
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 3
    question: "\uB2F4\uC999\uC744 \uC800\uC7A5\uD558\uB294 \uC8FC\uBA38\uB2C8\uB294?"
    answer: gallbladder
  - id: medexam_04_04
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 4
    question: "\uCDCC\uC7A5\uACFC \uCD1D\uB2F4\uAD00\uC774 \uC2ED\uC774\uC9C0\uC7A5\uC73C\uB85C
      \uD568\uAED8 \uAC1C\uAD6C\uD558\uC5EC \uB2F4\uC999\uACFC \uCDCC\uC7A5\uC561\uC744
      \uBD84\uBE44\uD558\uB294 \uCCB4\uACC4\uC758 \uC2ED\uC774\uC9C0\uC7A5\uC5D0
      \uB2FF\uC740 \uB05D \uBD80\uBD84\uC740?"
    answer: ampullar of Vater
  - id: medexam_04_05
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 5
    question: "\uC785\uC548\uC73C\uB85C \uC5F4\uB9AC\uB294 \uC0D8\uC73C\uB85C \uADC0\uBC11\uC0D8,
      \uD131\uBC11\uC0D8, \uD600\uBC11\uC0D8\uC758 \uC138 \uC885\uB958\uB97C \uC774\uB974\uB294
      \uAC83\uC740?"
    answer: salivary gland
  - id: medexam_04_06
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 6
    question: "\uC774\uBFCC\uB9AC\uB97C \uB458\uB7EC\uC2F8\uACE0 \uC788\uB294 \uC0B4\uC740?"
    answer: gingiva
  - id: medexam_04_07
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 7
    question: "\uC704\uC758 \uD55C \uBD80\uBD84\uC73C\uB85C \uC2DD\uB3C4\uC640 \uC5F0\uACB0\uC774
      \uB418\uB294 \uBD80\uC704\uB294?"
    answer: cardia
  - id: medexam_04_08
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 8
    question: "\uBCF5\uAC15\uC5D0 \uC7A5\uC561\uC131 \uC561\uCCB4\uAC00 \uAD34\uB294
      \uBCD1\uC801 \uC0C1\uD0DC \uB610\uB294 \uADF8 \uC561\uCCB4\uB294?"
    answer: ascites
  - id: medexam_04_09
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 9
    question: "\uCE68 \uBC30\uC124\uAD00 \uB0B4\uC5D0\uC11C \uD0C8\uB77D\uC0C1\uD53C\uB098
      \uC774\uBB3C\uC774 \uD575\uC774 \uB418\uC5B4 \uCE68\uC0D8\uCCB4\uB0B4 \uB610\uB294
      \uB3C4\uAD00 \uB0B4\uC5D0 \uC11D\uD68C\uD654 \uCE68\uCC29\uC774 \uC77C\uC5B4\uB098
      \uB3CC\uC774 \uB41C \uAC83\uC740?"
    answer: sialolithiasis
  - id: medexam_04_10
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 10
    question: "\uB300\uAC1C \uAC04\uACBD\uD654\uC99D\uC774 \uC6D0\uC778\uC73C\uB85C
      \uAC04\uBB38\uB9E5\uC5D0 \uD608\uC561\uC774 \uACE0\uC5EC \uBB38\uB9E5\uC555\uC774
      \uB192\uC544\uC838\uC11C \uC0DD\uAE30\uB294 \uAC83\uC740?"
    answer: esophageal varix
  - id: medexam_04_11
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 11
    question: "\uD68C\uC7A5\uC758 \uB05D\uBD80\uBD84\uC5D0 \uD638\uBC1C\uD558\uB294
      \uC124\uC0AC, \uBCF5\uD1B5, \uC5F4\uC744 \uB3D9\uBC18\uD55C \uC6D0\uC778\uBD88\uBA85\uC758
      \uC7A5\uC758 \uB9CC\uC131 \uC5FC\uC99D\uC740?"
    answer: Crohn's disease
  - id: medexam_04_12
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 12
    question: "\uD56D\uBB38\uAD00\uC744 \uB458\uB7EC\uC2F8\uB294 \uC810\uB9C9\uC774\uB098
      \uD56D\uBB38\uC758 \uC678\uBD80\uB97C \uB36E\uB294 \uD53C\uBD80\uC544\uB798\uC5D0
      \uC788\uB294 \uC815\uB9E5\uC758 \uB9DD\uC0C1\uC870\uC9C1\uC774 \uBD80\uD480\uC5B4\uC11C
      \uC0DD\uAE34 \uB369\uC5B4\uB9AC\uB294?"
    answer: hemorrhoid
  - id: medexam_04_13
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 13
    question: "\uD608\uC561\uC911\uC5D0 \uBE4C\uB9AC\uB8E8\uBE48 \uC591\uC774 \uC99D\uAC00\uD558\uC5EC
      \uD53C\uBD80 \uBC0F \uC810\uB9C9 \uB0B4 \uB2F4\uC999\uC758 \uCD95\uC801\uC73C\uB85C
      \uD669\uC0C9\uC744 \uB098\uD0C0\uB0B4\uB294 \uBCD1\uC801\uC0C1\uD0DC\uB294?"
    answer: jaundice
  - id: medexam_04_14
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 14
    question: "\uC0C5\uAD74(\uC0AC\uD0C0\uAD6C\uB2C8)\uC744 \uD1B5\uD558\uC5EC \uC7A5\uC774
      \uBE60\uC838\uB098\uC624\uB294 \uAC83\uC740?"
    answer: inguinal hernia
  - id: medexam_04_15
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 15
    question: "\uC704\uC554\uD658\uC790\uC758 \uC704\uC808\uC81C\uC218\uC220\uC5D0\uC11C
      Billroth I, Billroth II \uC218\uC220\uC758 \uBB38\uD569\uC220\uC744 \uAC01\uAC01
      \uAE30\uC7AC\uD558\uC2DC\uC624."
    answer: 'Billroth I: gastroduodenostomy / Billroth II: gastrojejunostomy'
  - id: medexam_04_16
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 16
    question: "\uC120\uCC9C\uC801\uC73C\uB85C \uC124\uC18C\uB300\uAC00 \uC9E7\uC740
      \uACBD\uC6B0\uC5D0 \uD574\uB2F9\uD558\uB294 \uC9C8\uD658\uBA85\uACFC \uC774\uC5D0
      \uC801\uD569\uD55C \uC218\uC220\uC744 \uC758\uD559\uC6A9\uC5B4\uB85C \uAC01\uAC01
      \uC4F0\uC2DC\uC624."
    answer: "\uC9C8\uD658\uBA85: ankyloglossia (= tongue tie) / \uC218\uC220\uBA85:
      frenotomy"
  - id: medexam_04_17
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 17
    question: "\uC18C\uD654\uD6A8\uC18C\uC758 \uD558\uB098\uC778 \uC4F8\uAC1C\uC999\uC744
      \uC0DD\uC131\uD558\uB294 \uC7A5\uAE30\uB294? (\u2460 stomach \u2461 spleen
      \u2462 liver \u2463 pancrease \u2464 villi)"
    answer: "\u2462 liver"
  - id: medexam_04_18
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 18
    question: "\uAC04\uC131\uB1CC\uC99D, \uD63C\uC218\uB3D9\uBC18\uC73C\uB85C \uAC11\uC791\uC2A4\uB7F0
      \uC0AC\uB9DD\uC5D0 \uC774\uB974\uB294 \uAC04\uC5FC\uC758 \uC885\uB958\uB294?
      (\u2460 fulminant hepatitis \u2461 autoimmune hepatitis \u2462 toxic hepatitis
      \u2463 alcoholic hepatitis \u2464 chronic hepatitis)"
    answer: "\u2460 fulminant hepatitis"
  - id: medexam_04_19
    chapter: 4
    chapterTitle: "\uC81C4\uC7A5 \uC18C\uD654\uAE30\uACC4"
    number: 19
    question: "\uCDCC\uC7A5\uC554\uACFC \uAD00\uB828\uC774 \uC5C6\uB294 \uC218\uC220\uC740?
      (\u2460 pancreatectomy \u2461 miles' operation \u2462 whipple's operation \u2463
      PPPD \u2464 pancreatoduodenectomy)"
    answer: "\u2461 miles' operation"
  - id: medexam_05_01
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 1
    question: "\uC18C\uBCC0\uC744 \uCCB4\uC678\uB85C \uBC30\uC124\uD558\uB294 \uAE30\uAD00\uC740?"
    answer: urethra
  - id: medexam_05_02
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 2
    question: "\uC18C\uBCC0\uC744 \uBC29\uAD11\uC73C\uB85C \uC6B4\uBC18\uD558\uB294
      \uAC00\uB298\uACE0 \uAE34 \uAD00\uC740?"
    answer: ureter
  - id: medexam_05_03
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 3
    question: "\uC18C\uBCC0\uC744 \uC0DD\uC0B0\uD558\uC5EC \uBC30\uCD9C\uD558\uB294
      \uAE30\uAD00\uC740?"
    answer: kidney
  - id: medexam_05_04
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 4
    question: "\uC2E0\uC7A5 \uC548\uC5D0 \uC788\uB294 \uAE54\uB300\uAE30 \uBAA8\uC591\uC758
      \uBE48\uACF3\uC740? (\uBCF4\uAE30: vesicovaginal fistula, urinary catheterization,
      colic, renal cell carcinoma, renal pelvis, uremia, interstitial nephritis,
      nephrosis, wilms' tumor, pyonephritis, ureterostomy, urethrotomy, azotemia,
      glomerulus, nephrostomy, cystocele, vesicorectal fistula, hypospadias, meatotomy,
      ureterovesicoplasty)"
    answer: renal pelvis
  - id: medexam_05_05
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 5
    question: "\uC2E0\uC7A5\uC758 \uD53C\uC9C8\uC5D0 \uC788\uB294 \uBAA8\uC138\uD608\uAD00
      \uB369\uC5B4\uB9AC\uB85C \uD608\uC561\uC131\uBD84\uC774 \uC5EC\uACFC\uB418\uC5B4
      \uC694\uC138\uAD00\uC73C\uB85C \uC6B4\uBC18\uB418\uB294 \uACF3\uC740? (\uBCF4\uAE30\uB294
      4\uBC88 \uBB38\uD56D\uACFC \uB3D9\uC77C)"
    answer: glomerulus
  - id: medexam_05_06
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 6
    question: "\uC2E0\uC7A5\uC758 \uAE30\uB2A5\uC774 \uB5A8\uC5B4\uC838\uC11C \uC9C8\uC18C
      \uD568\uC720 \uD654\uD569\uBB3C\uC774 \uD608\uC561\uC18D\uC5D0 \uC9C0\uB098\uCE58\uAC8C
      \uB9CE\uC774 \uB4E4\uC5B4 \uC788\uB294 \uC0C1\uD0DC\uB294? (\uBCF4\uAE30\uB294
      4\uBC88 \uBB38\uD56D\uACFC \uB3D9\uC77C)"
    answer: azotemia
  - id: medexam_05_07
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 7
    question: "\uC2E0\uC7A5\uC758 \uC0AC\uC774\uC9C8\uC5D0 \uC5FC\uC99D\uC774 \uC77C\uC5B4\uB098\uC11C
      \uCC28\uCC28 \uC2E0\uC7A5\uC804\uCCB4\uC5D0 \uBCD1\uBCC0\uC774 \uBBF8\uCE58\uB294
      \uD615\uD0DC\uC758 \uC2E0\uC7A5\uC5FC\uC740? (\uBCF4\uAE30\uB294 4\uBC88 \uBB38\uD56D\uACFC
      \uB3D9\uC77C)"
    answer: interstitial nephritis
  - id: medexam_05_08
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 8
    question: "\uBC29\uAD11\uC774 \uC81C\uC790\uB9AC\uB97C \uC9C0\uD0A4\uC9C0 \uBABB\uD558\uACE0
      \uBC11\uC73C\uB85C \uCC98\uC838\uC11C \uB0B4\uB824\uC628 \uAC83\uC740? (\uBCF4\uAE30\uB294
      4\uBC88 \uBB38\uD56D\uACFC \uB3D9\uC77C)"
    answer: cystocele
  - id: medexam_05_09
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 9
    question: "\uC120\uCC9C\uC131 \uAE30\uD615\uC73C\uB85C \uC694\uB3C4\uC758 \uAC1C\uAD6C\uAC00
      \uC74C\uACBD\uC544\uB798\uCABD\uC5D0 \uC788\uB294 \uACBD\uC6B0\uB294? (\uBCF4\uAE30\uB294
      4\uBC88 \uBB38\uD56D\uACFC \uB3D9\uC77C)"
    answer: hypospadias
  - id: medexam_05_10
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 10
    question: "\uC2E0\uC7A5\uC5D0\uC11C \uBC1C\uC0DD\uD558\uB294 \uC545\uC131\uC885\uC591\uC73C\uB85C
      \uC18C\uC544\uC5D0\uC11C \uC790\uC8FC\uBC1C\uC0DD\uD558\uB294 \uAC83\uC740?
      (\uBCF4\uAE30\uB294 4\uBC88 \uBB38\uD56D\uACFC \uB3D9\uC77C)"
    answer: Wilms' tumor
  - id: medexam_05_11
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 11
    question: "\uBC29\uAD11\uC5D0\uC11C \uC9C8\uB85C \uD1B5\uD558\uB294 \uBE44\uC815\uC0C1\uC801\uC778
      \uC5F0\uACB0\uD1B5\uB85C\uB294? (\uBCF4\uAE30\uB294 4\uBC88 \uBB38\uD56D\uACFC
      \uB3D9\uC77C)"
    answer: vesicovaginal fistula
  - id: medexam_05_12
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 12
    question: "\uC694\uB3C4\uD611\uCC29\uC744 \uCE58\uB8CC\uD558\uAE30 \uC704\uD55C
      \uC808\uAC1C\uC218\uC220\uC740? (\uBCF4\uAE30\uB294 4\uBC88 \uBB38\uD56D\uACFC
      \uB3D9\uC77C)"
    answer: urethrotomy
  - id: medexam_05_13
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 13
    question: "\uCE58\uB8CC, \uC9C4\uB2E8\uC758 \uBAA9\uC801\uC73C\uB85C \uAC00\uB290\uB2E4\uB780
      \uAE34 \uAD00\uC744 \uBC29\uAD11\uC5D0 \uC0BD\uC785\uD558\uC5EC \uC18C\uBCC0\uC744
      \uBF51\uC544\uB0B4\uB294 \uC77C\uC740? (\uBCF4\uAE30\uB294 4\uBC88 \uBB38\uD56D\uACFC
      \uB3D9\uC77C)"
    answer: urinary catheterization
  - id: medexam_05_14
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 14
    question: "\uC694\uAD00\uC758 \uC18C\uBCC0\uC744 \uBC30\uC124\uD558\uB294 \uC0DB\uAE38\uC744
      \uC601\uAD6C\uC801\uC73C\uB85C \uB9CC\uB4DC\uB294 \uC218\uC220\uC740? (\uBCF4\uAE30\uB294
      4\uBC88 \uBB38\uD56D\uACFC \uB3D9\uC77C)"
    answer: ureterostomy
  - id: medexam_05_15
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 15
    question: "\uBCF5\uB9C9\uAC15 \uB0B4\uB85C \uAD00\uC744 \uC5F0\uACB0\uD558\uC5EC
      \uC774 \uC18D\uC73C\uB85C \uD22C\uC11D\uC561\uC744 \uB123\uC5B4 \uD22C\uC11D\uD558\uB294
      \uBC29\uBC95\uC740?"
    answer: peritoneal dialysis
  - id: medexam_05_16
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 16
    question: "\uC2E0\uC7A5\uC758 \uAD6C\uC870\uC801, \uAE30\uB2A5\uC801 \uB2E8\uC704\uB85C
      \uD55C\uCABD\uC2E0\uC7A5\uC5D0 100\uB9CC\uAC1C \uC788\uB294 \uC774\uAC83\uC740?"
    answer: nephron
  - id: medexam_05_17
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 17
    question: "\uC2E0\uD608\uAD00 \uBC0F \uC694\uAD00\uC774 \uD1B5\uACFC\uD558\uB294
      \uC2E0\uC7A5 \uC548\uCABD\uC758 \uC624\uBAA9\uD55C \uBD80\uBD84\uC740? (\u2460
      calyx \u2461 cortex \u2462 hilum \u2463 renal pelvis \u2464 renal papillae)"
    answer: "\u2462 hilum"
  - id: medexam_05_18
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 18
    question: "\uB450 \uAC1C\uC758 \uC2E0\uC7A5\uC774 \uD558\uB098\uB85C \uBD99\uC5B4
      \uC788\uB294 \uC120\uCC9C\uC801\uC778 \uC9C8\uD658\uC740? (\u2460 renal ectopia
      \u2461 polycystic kidney \u2462 horseshoe kidney \u2463 fused kidney \u2464
      supernumerary kidney)"
    answer: "\u2463 fused kidney"
  - id: medexam_05_19
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 19
    question: "\uC18C\uBCC0 \uB0B4 RBC\uAC00 \uAC80\uCD9C\uB41C \uACBD\uC6B0\uB294?
      (\u2460 hematuria \u2461 glycosuria \u2462 uremia \u2463 proteinuria \u2464
      nocturia)"
    answer: "\u2460 hematuria"
  - id: medexam_05_20
    chapter: 5
    chapterTitle: "\uC81C5\uC7A5 \uBE44\uB1E8\uAE30\uACC4"
    number: 20
    question: "\uB2E4\uC74C\uC911 renal failure \uD658\uC790\uC5D0\uAC8C \uC2E4\uC2DC\uD558\uB294
      \uC2DC\uC220\uC740? (\u2460 urinalysis \u2461 hemodialysis \u2462 transsonography
      \u2463 cystectomy \u2464 renal plasty)"
    answer: "\u2461 hemodialysis"
  - id: medexam_06_01
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 1
    question: "1. \uB09C\uC790\uAC00 \uC790\uAD81\uC73C\uB85C \uC6B4\uBC18\uB418\uB294
      \uACF3\uC73C\uB85C \uC790\uAD81\uC758 \uB09C\uC18C\uBD80\uAE4C\uC9C0 \uBED7\uB294
      \uAE38\uACE0 \uAC00\uB294 \uAD00\uC740? (\uADF8\uB9BC K)"
    answer: uterine tube (= fallopian tube)
  - id: medexam_06_02
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 2
    question: "2. \uC218\uC815\uC5D0 \uD544\uC694\uD55C \uB09C\uC790\uB97C \uC0DD\uC131\uD558\uB294
      \uACF3\uC740? (\uADF8\uB9BC J)"
    answer: ovary
  - id: medexam_06_03
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 3
    question: "3. \uCD9C\uC0B0 \uC2DC \uD33D\uCC3D\uD558\uC5EC \uC5F4\uB9AC\uBA70,
      \uC790\uAD81\uACFC \uC9C8 \uB610\uB294 \uC0B0\uB3C4\uB97C \uC787\uB294 \uC5F0\uACB0\uAD00\uC73C\uB85C
      \uC9C8\uC758 \uC0C1\uBD80\uC5D0 \uC788\uB294 \uACF3\uC740? (\uADF8\uB9BC E)"
    answer: uterine cervix
  - id: medexam_06_04
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 4
    question: "5. \uC8FC\uB85C \uC790\uAD81\uACBD\uBD80\uC5FC\uC73C\uB85C \uC778\uD558\uC5EC
      \uC5EC\uC131\uC758 \uC9C8\uBD84\uBE44\uBB3C\uC774 \uD758\uB7EC\uB098\uC624\uB294
      \uAC83\uC740?  [\uBCF4\uAE30] D&C / conization / uterine myoma / colpitis(=vaginitis)
      / secretory phase / adenomyosis / endometriosis / placenta / Brenner tumor
      / ovarian tumor / leiomyoma / ectopic pregnancy / ovulation period / show /
      leukorrhea / fertilization / pelvic inflammatory disease / lochia / vulvovaginitis
      / cesarean resection"
    answer: leukorrhea
  - id: medexam_06_05
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 5
    question: "6. \uC678\uC74C\uBD80, \uC9C8 \uB4F1\uC758 \uC544\uB798\uCABD\uC5D0
      \uC0DD\uAE34 \uC5FC\uC99D\uC774 \uC790\uAD81, \uB09C\uAD00, \uB09C\uC18C, \uBCF5\uB9C9
      \uBC0F \uC778\uC811\uC870\uC9C1 \uB4F1 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uC5D0
      \uC804\uD30C\uB418\uB294 \uC0C1\uD589\uC5FC\uC99D\uC131 \uC9C8\uD658\uC740? 
      [\uBCF4\uAE30] D&C / conization / uterine myoma / colpitis(=vaginitis) / secretory
      phase / adenomyosis / endometriosis / placenta / Brenner tumor / ovarian tumor
      / leiomyoma / ectopic pregnancy / ovulation period / show / leukorrhea / fertilization
      / pelvic inflammatory disease / lochia / vulvovaginitis / cesarean resection"
    answer: pelvic inflammatory disease
  - id: medexam_06_06
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 6
    question: "7. \uC790\uAD81\uB0B4\uB9C9 \uC870\uC9C1\uC774 \uC874\uC7AC\uD558\uC5EC\uC57C
      \uD558\uB294 \uBD80\uC704 \uC774\uC678\uC758 \uC7A5\uC18C\uC5D0 \uC874\uC7AC\uD558\uB294
      \uAC83\uC740?  [\uBCF4\uAE30] D&C / conization / uterine myoma / colpitis(=vaginitis)
      / secretory phase / adenomyosis / endometriosis / placenta / Brenner tumor
      / ovarian tumor / leiomyoma / ectopic pregnancy / ovulation period / show /
      leukorrhea / fertilization / pelvic inflammatory disease / lochia / vulvovaginitis
      / cesarean resection"
    answer: endometriosis
  - id: medexam_06_07
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 7
    question: "8. \uC790\uAD81\uC758 \uD3C9\uD65C\uADFC\uACFC \uACB0\uD569\uC870\uC9C1\uC12C\uC720\uC758
      \uC774\uC0C1\uC99D\uC2DD\uC73C\uB85C \uBC1C\uC0DD\uD558\uB294 \uB300\uD45C\uC801
      \uC591\uC131\uC885\uC591\uC740?  [\uBCF4\uAE30] D&C / conization / uterine
      myoma / colpitis(=vaginitis) / secretory phase / adenomyosis / endometriosis
      / placenta / Brenner tumor / ovarian tumor / leiomyoma / ectopic pregnancy
      / ovulation period / show / leukorrhea / fertilization / pelvic inflammatory
      disease / lochia / vulvovaginitis / cesarean resection"
    answer: uterine myoma
  - id: medexam_06_08
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 8
    question: "9. \uC138\uADE0, \uCE78\uB514\uB2E4, \uD2B8\uB9AC\uCF54\uBAA8\uB098\uC2A4\uC758
      \uAC10\uC5FC\uC774\uB098 \uC57D\uBB3C \uB4F1\uC73C\uB85C \uC9C8 \uC810\uB9C9\uC5D0
      \uC0DD\uAE30\uB294 \uC5FC\uC99D\uC740?  [\uBCF4\uAE30] D&C / conization / uterine
      myoma / colpitis(=vaginitis) / secretory phase / adenomyosis / endometriosis
      / placenta / Brenner tumor / ovarian tumor / leiomyoma / ectopic pregnancy
      / ovulation period / show / leukorrhea / fertilization / pelvic inflammatory
      disease / lochia / vulvovaginitis / cesarean resection"
    answer: colpitis (= vaginitis)
  - id: medexam_06_09
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 9
    question: "10. \uBD84\uB9CC \uB610\uB294 \uC6D4\uACBD\uC774 \uC77C\uC5B4\uB098\uAE30
      \uC804\uC5D0 \uB098\uD0C0\uB098\uB294 \uCD9C\uD608?  [\uBCF4\uAE30] D&C / conization
      / uterine myoma / colpitis(=vaginitis) / secretory phase / adenomyosis / endometriosis
      / placenta / Brenner tumor / ovarian tumor / leiomyoma / ectopic pregnancy
      / ovulation period / show / leukorrhea / fertilization / pelvic inflammatory
      disease / lochia / vulvovaginitis / cesarean resection"
    answer: show
  - id: medexam_06_10
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 10
    question: "11. \uD0DC\uC544\uC640 \uBAA8\uCCB4 \uC0AC\uC774\uC758 \uAC00\uC2A4
      \uBC0F \uBB3C\uC9C8 \uAD50\uD658\uACFC \uC784\uC2E0\uC720\uC9C0\uB97C \uC704\uD55C
      \uB0B4\uBD84\uBE44\uBB3C\uC9C8\uC744 \uBD84\uBE44\uD558\uB294 \uAE30\uAD00\uC740? 
      [\uBCF4\uAE30] D&C / conization / uterine myoma / colpitis(=vaginitis) / secretory
      phase / adenomyosis / endometriosis / placenta / Brenner tumor / ovarian tumor
      / leiomyoma / ectopic pregnancy / ovulation period / show / leukorrhea / fertilization
      / pelvic inflammatory disease / lochia / vulvovaginitis / cesarean resection"
    answer: placenta
  - id: medexam_06_11
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 11
    question: "12. \uB0A8\uC131\uACFC \uC5EC\uC131\uC758 \uC0DD\uC2DD\uC138\uD3EC\uAC00
      \uACB0\uD569\uD558\uB294 \uACFC\uC815\uC740?  [\uBCF4\uAE30] D&C / conization
      / uterine myoma / colpitis(=vaginitis) / secretory phase / adenomyosis / endometriosis
      / placenta / Brenner tumor / ovarian tumor / leiomyoma / ectopic pregnancy
      / ovulation period / show / leukorrhea / fertilization / pelvic inflammatory
      disease / lochia / vulvovaginitis / cesarean resection"
    answer: fertilization
  - id: medexam_06_12
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 12
    question: "13. \uBD84\uB9CC \uD6C4 \uC81C1\uC8FC \uB610\uB294 \uC81C2\uC8FC \uC0AC\uC774\uC5D0
      \uB098\uD0C0\uB098\uB294 \uC9C8\uBD84\uBE44\uBB3C\uC740?  [\uBCF4\uAE30] D&C
      / conization / uterine myoma / colpitis(=vaginitis) / secretory phase / adenomyosis
      / endometriosis / placenta / Brenner tumor / ovarian tumor / leiomyoma / ectopic
      pregnancy / ovulation period / show / leukorrhea / fertilization / pelvic inflammatory
      disease / lochia / vulvovaginitis / cesarean resection"
    answer: lochia
  - id: medexam_06_13
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 13
    question: "14. \uB09C\uC18C\uC885\uC591\uC73C\uB85C \uC12C\uC720\uC131 \uACB0\uD569\uC870\uC9C1
      \uAE30\uC9C8\uC5D0 \uC0C1\uD53C\uC138\uD3EC\uAC00 \uC904\uC9C0\uC5B4 \uC788\uB294
      \uAC83\uC740?  [\uBCF4\uAE30] D&C / conization / uterine myoma / colpitis(=vaginitis)
      / secretory phase / adenomyosis / endometriosis / placenta / Brenner tumor
      / ovarian tumor / leiomyoma / ectopic pregnancy / ovulation period / show /
      leukorrhea / fertilization / pelvic inflammatory disease / lochia / vulvovaginitis
      / cesarean resection"
    answer: Brenner tumor
  - id: medexam_06_14
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 14
    question: "15. \uC790\uAD81\uACBD\uBD80\uB97C \uB113\uD600\uC11C \uC790\uAD81
      \uC18D\uC758 \uB0B4\uB9C9\uC870\uC9C1\uC744 \uAE01\uC5B4\uB0B4\uB294 \uAC83? 
      [\uBCF4\uAE30] D&C / conization / uterine myoma / colpitis(=vaginitis) / secretory
      phase / adenomyosis / endometriosis / placenta / Brenner tumor / ovarian tumor
      / leiomyoma / ectopic pregnancy / ovulation period / show / leukorrhea / fertilization
      / pelvic inflammatory disease / lochia / vulvovaginitis / cesarean resection"
    answer: D&C (dilation and curettage)
  - id: medexam_06_15
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 15
    question: "16. \uC5EC\uC131\uC758 \uB300\uD45C\uC801\uC778 \uBD88\uC784\uC218\uC220\uB85C
      \uB09C\uAD00\uC744 \uD3D0\uC1C4\uC2DC\uD0A4\uB294 \uAC83\uC740?"
    answer: tubal ligation
  - id: medexam_06_16
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 16
    question: "17. \uC790\uAD81\uACBD\uAD00\uC758 \uD655\uC7A5\uC774 \uC77C\uC5B4\uB098\uC9C0
      \uC54A\uB294 \uD6A8\uACFC\uAC00 \uC5C6\uB294 \uC9C4\uD1B5\uC740?"
    answer: false labor
  - id: medexam_06_17
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 17
    question: "18. \uC790\uAD81, \uB09C\uAD00, \uB09C\uC18C, \uC790\uAD81\uC606 \uC870\uC9C1,
      \uC9C8\uC758 \uC77C\uBD80, \uACE8\uBC18\uB9BC\uD504\uC808\uAE4C\uC9C0 \uD3EC\uD568\uD558\uC5EC
      \uC808\uC81C\uD558\uB294 \uC218\uC220\uC740? \u2460 LEEP \u2461 TAH \u2462
      TVH \u2463 panhysterectomy \u2464 RH"
    answer: "\u2464 RH (radical hysterectomy)"
  - id: medexam_06_18
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 18
    question: "19. \uB2E4\uC74C\uC911 \uC784\uC2E0\uACFC \uAC00\uC7A5 \uAD00\uB828\uC774
      \uBA3C \uAC83\uC740? \u2460 pseudocyesis \u2461 false labor \u2462 gravida
      \u2463 toxemia \u2464 amniocentesis"
    answer: "\u2460 pseudocyesis"
  - id: medexam_06_19
    chapter: 6
    chapterTitle: "\uC81C6\uC7A5 \uC5EC\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 19
    question: "20. menstruation\uC2DC \uD0C8\uB77D\uB418\uB294 \uC790\uAD81 \uC870\uC9C1\uC740?
      \u2460 myometrium \u2461 epimetrium \u2462 endometrium \u2463 parametrium \u2464
      perimetrium"
    answer: "\u2462 endometrium"
  - id: medexam_07_01
    chapter: 7
    chapterTitle: "\uC81C7\uC7A5 \uB0A8\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 1
    question: "1. \uC815\uC790\uB97C \uB9CC\uB4E4\uACE0 \uB0A8\uC131\uD638\uB974\uBAAC\uC744
      \uBD84\uBE44\uD558\uB294 \uAE30\uAD00\uC740? (\uADF8\uB9BC A~P)"
    answer: "testis (\uACE0\uD658, \uAE30\uD638 I)"
  - id: medexam_07_02
    chapter: 7
    chapterTitle: "\uC81C7\uC7A5 \uB0A8\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 2
    question: "2. \uC815\uC561\uC744 \uC0DD\uC0B0\uD558\uACE0 \uC800\uC7A5\uD558\uB294
      \uAE30\uAD00\uC740? (\uADF8\uB9BC A~P)"
    answer: "seminal vesicle (\uC815\uB0AD, \uAE30\uD638 P)"
  - id: medexam_07_03
    chapter: 7
    chapterTitle: "\uC81C7\uC7A5 \uB0A8\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 3
    question: "3. \uB0A8\uC131\uC758 \uC694\uB3C4\uAC00 \uC2DC\uC791\uB418\uB294
      \uBD80\uC704\uB97C \uACE0\uB9AC\uBAA8\uC591\uC73C\uB85C \uB458\uB7EC\uC2F8\uB294
      \uC7A5\uAE30\uB85C \uC815\uC561\uC758 \uC561\uCCB4 \uC131\uBD84\uC744 \uC774\uB8E8\uB294
      \uC720\uBC31\uC0C9\uC758 \uC561\uCCB4\uB97C \uC694\uB3C4\uB85C \uBD84\uBE44\uD558\uC5EC
      \uC815\uC790\uC758 \uC6B4\uB3D9\uC744 \uD65C\uBC1C\uD558\uAC8C \uD558\uB294
      \uAE30\uAD00\uC740? (\uADF8\uB9BC A~P)"
    answer: "prostate gland (\uC804\uB9BD\uC0D8, \uAE30\uD638 M)"
  - id: medexam_07_04
    chapter: 7
    chapterTitle: "\uC81C7\uC7A5 \uB0A8\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 4
    question: "4. \uC815\uB0AD\uC5D0 \uBAA8\uC778 \uC815\uC561\uC740 \uC774\uACF3\uC744
      \uD1B5\uD574 \uC694\uB3C4\uB85C \uC5F0\uACB0\uB418\uC5B4 \uCCB4\uC678\uB85C
      \uBC30\uCD9C\uB41C\uB2E4. (\uADF8\uB9BC A~P)"
    answer: "ejaculatory duct (\uC0AC\uC815\uAD00, \uAE30\uD638 O)"
  - id: medexam_07_05
    chapter: 7
    chapterTitle: "\uC81C7\uC7A5 \uB0A8\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 5
    question: "5. \uC74C\uACBD\uC774 \uC0DD\uB9AC\uC801\uC73C\uB85C \uD33D\uB300
      \uAC15\uC9C1\uD558\uAC8C \uB418\uB294 \uAC83\uC740?  [\uBCF4\uAE30] placenta
      previa / ectopic pregnancy / venereal disease / gonorrhea / erection / induced
      abortion / BPH / mammoplasty / balanoplasty / spermatic cord / abruptio placentae
      / phimosis / CPD / cryptorchidism / varicocele / hydrocele / missed abortion
      / TURP / orchiectomy / prepuce"
    answer: erection
  - id: medexam_07_06
    chapter: 7
    chapterTitle: "\uC81C7\uC7A5 \uB0A8\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 6
    question: "6. \uC74C\uB0AD \uB0B4\uC758 \uACE0\uD658 \uC8FC\uC704\uC758 \uACF5\uAC04
      \uB0B4\uC5D0 \uBB34\uCDE8\uC758 \uB2F4\uD669\uC0C9 \uC561\uCCB4\uAC00 \uAD34\uB294
      \uC0C1\uD0DC\uB294?  [\uBCF4\uAE30] placenta previa / ectopic pregnancy / venereal
      disease / gonorrhea / erection / induced abortion / BPH / mammoplasty / balanoplasty
      / spermatic cord / abruptio placentae / phimosis / CPD / cryptorchidism / varicocele
      / hydrocele / missed abortion / TURP / orchiectomy / prepuce"
    answer: hydrocele
  - id: medexam_07_07
    chapter: 7
    chapterTitle: "\uC81C7\uC7A5 \uB0A8\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 7
    question: "7. \uC815\uC0C1\uC801\uC73C\uB85C \uC74C\uB0AD\uC73C\uB85C \uB0B4\uB824\uC640\uC57C
      \uD558\uB294 \uACE0\uD658\uC774 \uB0B4\uB824\uC624\uC9C0 \uC54A\uACE0 \uACC4\uC18D
      \uBCF5\uAC15\uC5D0 \uBA38\uBB34\uB294 \uAC83\uC740?  [\uBCF4\uAE30] placenta
      previa / ectopic pregnancy / venereal disease / gonorrhea / erection / induced
      abortion / BPH / mammoplasty / balanoplasty / spermatic cord / abruptio placentae
      / phimosis / CPD / cryptorchidism / varicocele / hydrocele / missed abortion
      / TURP / orchiectomy / prepuce"
    answer: cryptorchidism
  - id: medexam_07_08
    chapter: 7
    chapterTitle: "\uC81C7\uC7A5 \uB0A8\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 8
    question: "8. \uC8FC\uB85C 50\uC138 \uC774\uC0C1\uC758 \uB0A8\uC790\uC5D0\uAC8C
      \uBC1C\uC0DD\uD558\uB294 \uC804\uB9BD\uC120\uBE44\uB300\uB294?  [\uBCF4\uAE30]
      placenta previa / ectopic pregnancy / venereal disease / gonorrhea / erection
      / induced abortion / BPH / mammoplasty / balanoplasty / spermatic cord / abruptio
      placentae / phimosis / CPD / cryptorchidism / varicocele / hydrocele / missed
      abortion / TURP / orchiectomy / prepuce"
    answer: BPH
  - id: medexam_07_09
    chapter: 7
    chapterTitle: "\uC81C7\uC7A5 \uB0A8\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 9
    question: "9. \uC131\uC801\uC811\uCD09\uC73C\uB85C \uAC10\uC5FC\uB418\uB294 \uBCD1\uC740? 
      [\uBCF4\uAE30] placenta previa / ectopic pregnancy / venereal disease / gonorrhea
      / erection / induced abortion / BPH / mammoplasty / balanoplasty / spermatic
      cord / abruptio placentae / phimosis / CPD / cryptorchidism / varicocele /
      hydrocele / missed abortion / TURP / orchiectomy / prepuce"
    answer: venereal disease
  - id: medexam_07_10
    chapter: 7
    chapterTitle: "\uC81C7\uC7A5 \uB0A8\uC131\uC0DD\uC2DD\uAE30\uACC4"
    number: 10
    question: "10. \uC74C\uACBD\uC758 \uADC0\uB450\uB97C \uC131\uD615\uD558\uB294
