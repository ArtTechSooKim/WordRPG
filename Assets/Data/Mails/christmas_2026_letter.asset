  m_Script: {fileID: 11500000, guid: 1abbb729d4ef5b04a8d1980f9a943cc0, type: 3}
  m_Name: christmas_2026_letter
  m_EditorClassIdentifier: WordRPG::WordRPG.Game.MailData
  mailId: christmas_2026_letter
  sender: "\uAC1C\uBC1C\uC790"
  subject: "\uD06C\uB9AC\uC2A4\uB9C8\uC2A4 \uD3B8\uC9C0"
  tag: "\uAC1C\uBC1C\uC790\uC758 \uD3B8\uC9C0"
  title: A Christmas Letter from the Developer
  art: tree
  body: "\uC0AC\uB791\uD558\uB294 \uBAA8\uD5D8\uAC00 \uC5EC\uB7EC\uBD84!\n\uC5B4\uB290\uB367
    \uD55C \uD574\uC758 \uB05D\uC790\uB77D, \uB530\uB73B\uD55C \uD06C\uB9AC\uC2A4\uB9C8\uC2A4\uAC00
    \uCC3E\uC544\uC654\uC2B5\uB2C8\uB2E4.\n\uC5EC\uB7EC\uBD84\uC740 \uC62C \uD55C
    \uD574 \uC5B4\uB5A4 \uBAA8\uD5D8\uC744 \uD558\uC168\uB098\uC694?\n\uC0C8\uB85C\uC6B4
    \uB2E8\uC5B4\uB97C \uBC30\uC6B0\uACE0, \uB0AF\uC120 \uB3C4\uC804\uC744 \uB9C8\uC8FC\uD558\uBA70
    \uD55C \uAC78\uC74C\uC529 \uC131\uC7A5\uD574 \uC628 \uC5EC\uB7EC\uBD84\uC758
    \uC5EC\uC815\uC5D0 \uD568\uAED8\uD560 \uC218 \uC788\uC5B4 \uAE30\uC069\uB2C8\uB2E4.\n\uD06C\uB9AC\uC2A4\uB9C8\uC2A4\uB294
    \uC0AC\uB791\uACFC \uD3C9\uD654\uB97C \uC804\uD558\uAE30 \uC704\uD574 \uC608\uC218\uB2D8\uAED8\uC11C
    \uC774 \uB545\uC5D0 \uD0DC\uC5B4\uB098\uC2E0 \uB0A0\uC785\uB2C8\uB2E4.\n\uAC8C\uC784
    \uC18D\uC5D0\uC11C \uAC15\uD55C \uBAAC\uC2A4\uD130\uB97C \uBB3C\uB9AC\uCE58\uACE0
    \uC0C8\uB85C\uC6B4 \uB808\uBCA8\uC5D0 \uB3C4\uB2EC\uD558\uB294 \uAC83\uB3C4 \uBA4B\uC9C4
    \uC77C\uC774\uC9C0\uB9CC, \uD604\uC2E4\uC5D0\uC11C\uB294 \uC11C\uB85C\uB97C \uC0AC\uB791\uD558\uACE0
    \uC791\uC740 \uCE5C\uC808\uC744 \uB098\uB204\uB294 \uAC83\uC774 \uB354\uC6B1
    \uAC12\uC9C4 \uBAA8\uD5D8\uC77C\uC9C0\uB3C4 \uBAA8\uB985\uB2C8\uB2E4.\n\uC774\uBC88
    \uD06C\uB9AC\uC2A4\uB9C8\uC2A4\uC5D0\uB294 \uC5EC\uB7EC\uBD84\uC758 \uB9C8\uC74C\uC5D0\uB3C4
    \uD3C9\uD654\uAC00 \uAE43\uB4E4\uAE30\uB97C \uBC14\uB78D\uB2C8\uB2E4. \uC804\uC7C1\uACFC
    \uAC08\uB4F1\uC73C\uB85C \uACE0\uD1B5\uBC1B\uB294 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C\uB3C4
    \uB530\uB73B\uD55C \uC704\uB85C\uC640 \uD76C\uB9DD\uC774 \uC804\uD574\uC9C0\uAE30\uB97C
    \uAE30\uB3C4\uD569\uB2C8\uB2E4.\n\uC800\uD76C \uAC8C\uC784\uACFC \uD568\uAED8\uD574
    \uC8FC\uC154\uC11C \uC9C4\uC2EC\uC73C\uB85C \uAC10\uC0AC\uD569\uB2C8\uB2E4.\n\uC5EC\uB7EC\uBD84\uC758
    \uB2E4\uC74C \uBAA8\uD5D8\uC5D0\uB3C4 \uC0C8\uB85C\uC6B4 \uBC30\uC6C0\uACFC \uC990\uAC70\uC6C0\uC774
    \uAC00\uB4DD\uD558\uAE30\uB97C!"
  closing: Merry Christmas & Happy New Adventure!
  sign: From. Your Game Developer
  attachments: []
  delivery: 0
  fromDate: 
  toDate: 
